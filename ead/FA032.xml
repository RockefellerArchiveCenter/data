  <dsc><c id="cff00ac6e28d44d8ae150f80bf9a8c6a" level="series"><did><unittitle>Tennessee</unittitle><unitid>1</unitid><unitid type="aspace_uri">/repositories/2/archival_objects/61985</unitid><physdesc altrender="whole"><extent altrender="materialtype spaceoccupied">0.38 Cubic Feet</extent><extent altrender="carrier">1 letter document box</extent></physdesc><unitdate datechar="creation" normal="1902/1910" type="inclusive">1902-1910</unitdate></did><scopecontent id="4e65841b3c04af654fbfdc16a41a35b2"><head>Scope and Contents note</head><p>Series 1 includes material from Dr. Rose's days in Tennessee and his affiliations with Peabody College and the University of Nashville. The period roughly covers the years 1902-1910. Much of the material consists of letters to Dr. Rose in appreciation for the work he did as an educator.</p></scopecontent><c id="b6f7fb0fbfe7434387de218ef5dfff09" level="file"><did><unittitle>Correspondence</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/61986</unitid><unitdate datechar="creation" normal="1902/1903" type="inclusive">1902-1903</unitdate><container altrender="Letter Document Box" id="8d28f269e5a5f874d8c0e35ac4a3d283" label="mixed materials [A0000000068244]" type="box">1</container><container id="7c015645c8be8b483b13ccd13de18339" parent="8d28f269e5a5f874d8c0e35ac4a3d283" type="folder">1</container></did></c><c id="94fec5e06d414784878f3dbc73b1a4e2" level="file"><did><unittitle>Correspondence</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/61987</unitid><unitdate datechar="creation" normal="1905/1906" type="inclusive">1905-1906</unitdate><container altrender="Letter Document Box" id="a098bba50e07697b577fc58d01017976" label="mixed materials [A0000000068244]" type="box">1</container><container id="47b1f931207090ad98e3eb9402fa5f0d" parent="a098bba50e07697b577fc58d01017976" type="folder">2</container></did></c><c id="463a06b8f271476ca55cdb60b8cb5500" level="file"><did><unittitle>Correspondence</unittitl