<p>As received.</p>  </arrangement>
  <acqinfo id="6eb0e36e8075727389c9c853f62fab1e">
    <head>Immediate Source of Acquisition</head>
<p>Donated to the RAC by Caroline W. Rupp (January 2017), granddaughter of John B. Trevor and great-granddaughter of John B. Trevor, Sr.</p>  </acqinfo>
  <userestrict id="8d269c0f760e2fc80d43db656f103ddb">
