5a0e7dfd">Sound, Color, 20 minutes</physdesc><materialspec id="e815b77a0a42efaaddaa7211764bccc3">16mm film</materialspec><container id="03bab4974f07a2df52e02e737634a592" label="moving images [A0000000106876]" type="reel">AV 2926</container></did><scopecontent id="6c940c528814e7af8135fce5c9f6e0f5"><head>Scope and Contents</head><p>A history of the Family as presented by CBS News. Walter Cronkite interviews Abby Mauze, JDR 3rd, Nelson, Laurance, and David Rockefeller.</p></scopecontent><accessrestrict id="bae6d42b4721c5a99bd6aeef969eec7a"><head>Conditions Governing Access</head><p>Open for research. Digital access copy available.</p></accessrestrict></c><c id="a89925ceb0d7297876cb894600e50af7" level="file"><did><unittitle>Rockefeller Center Expansion - WNBC-TV news segment</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/1246693</unitid><unitdate calendar="gregorian" datechar="creation" era="ce" normal="1965-12/1965-12">1970 December</unitdate><physdesc id="1f69a645d63abe20a36d74cd30dd548f">Sound, Color, 4 minutes</physdesc><materialspec id="18a6b1c9d845f023fab2b0f8734de513">16mm film</materialspec><container id="d185060c0dd09e95395e446e25561046" label="moving images [A0000000106851]" type="reel">AV 1536</container></did><accessrestrict id="3e5b3dd6f821f869e0329e78fc73da2f"><head>Conditions Governing Access</head><p>Open for research. Digital access copy available.</p></accessrestrict><scopecontent id="665a650af0c0c4e4a71e63598b80cc81"><head>Scope and Contents</head><p>Retiring Rockefeller Center president Gustav S. Eyssell interviewed by WNBC reporter Peter Simmons regarding the history and curent expansion of Rockefeller Center. Includes construction images of Celanese, McGraw-Hill, and Standard Oil buildings. This news segment is believed to have been broadcast on 6th Hour News.</p></scopecontent></c><c id="f6a9f5e1122d43d4956e0d360de95b22" level="file"><did><unittitle>Scenes of Kykuit</unittitle><unitid type="aspace_uri">/repositories/2/archiv