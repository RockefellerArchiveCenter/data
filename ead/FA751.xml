  <dsc><c id="9d734caca80a4b39a16be3b448f612b2" level="series"><did><unittitle>Rockefeller family moving image materials, General</unittitle><unitid>1</unitid><unitid type="aspace_uri">/repositories/2/archival_objects/887520</unitid><unitdate datechar="creation" normal="1931/1990" type="inclusive">1931-1990</unitdate></did><scopecontent id="aspace_26031317b8b46c5f89d2831eaaa49255"><head>Scope and Contents</head><p>The Rockefeller family films represent a mix of private family footage and published recordings from a multitude of sources.</p><p>Ask a reference staff member for more information about these films.</p></scopecontent><c id="9d2c09aa3cc882d4c336695f86e42f3a" level="file"><did><unittitle>Construction of Rockefeller Center </unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/1246682</unitid><unitdate calendar="gregorian" datechar="creation" era="ce" normal="1931-07/1932-03" type="inclusive">1931 July-1932 March</unitdate><materialspec id="9a3e483d56764fac34379bc35a26f79d">35mm</materialspec><physdesc id="de0c435c720080207d21d36e8084e371">Silent, Black and white, 7 minutes</physdesc><container altrender="35mm (400ft) Film Can" id="08a81899f0f92f9a105c8d8317da4f2f" label="moving images [A0000000106882]" type="reel">AV 1602</container></did><accessrestrict id="499f3962dbc861d28bfe05a22972f836"><head>Conditions Governing Access</head><p>Open for research. Digital access available.</p></accessrestrict><phystech id="987c48bd0155fd9abf99e1dea9e70227"><head>Physical Characteristics and Technical Requirements</head><p>A "ghost line" appears sporadically throughout film.</p></phystech><scopecontent id="5cceae4efdb88c34087304297d739ba1"><head>Scope and Contents</head><p>Excavation of British Empire Building / La Maison Francais and Radio City Music Hall / RKO Building sites by the George Atwell Foundation Corp. Steel work on the demolished Center Theatre and RKO Building (1270 Sixth Avenue) by John Lowry, Inc.</p></scopecontent></c><c id="f25f560ad1bf41209b65e2b025b7b4a2" level="file"><did><unittitle>CBS Reports: The Rockefellers - Reel 1, CBS-TV</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/887537</unitid><unitdate calendar="gregorian" datechar="creation" era="ce" normal="1973/1973">1973</unitdate><physdesc id="aspace_2e04c76afe4688cae726a2385aad6637">Sound, Color, 20 minutes</physdesc><materialspec id="268f69715fe79bc699b581f06ee1c9f5">16mm film</materialspec><container id="33f0292cd31ac468db4045e6139a84de" label="moving images [A0000000106872]" type="reel">AV 2923</container></did><accessrestrict id="aspace_67460535ae740e2c03990d99a1f00631"><head>Conditions Governing Access note</head><p>Open for research. Digital access copy available.</p></accessrestrict><scopecontent id="aspace_d19a8fe5f822400037ad6a446de72b85"><head>Scope and Contents note</head><p>A history of the Family as presented by CBS News. Walter Cronkite interviews Abby Mauze, JDR 3rd, Nelson, Laurance, and David Rockefeller.</p></scopecontent><controlaccess><genreform source="lcsh">Filmed interviews</genreform><subject source="lcsh">Family history </subject><corpname source="naf">CBS News</corpname><famname rules="dacs" source="local">Rockefeller family</famname><persname rules="dacs">Mauze, Abby Rockefeller (1903-1976)</persname><persname source="naf">Cronkite, Walter</persname><persname source="naf">Rockefeller, Nelson A. (Nelson Aldrich) (1908-1979)</persname><persname source="naf">Rockefeller, John D., III (John Davison) (1906-1978)</persname><persname source="naf">Rockefeller, David (1915-2017)</persname><persname source="naf">Rockefeller, Laurance Spelman (1910-2004)</persname></controlaccess></c><c id="43a0cef93e465d9efade446d13441217" level="file"><did><unittitle>CBS Reports: The Rockefellers - Reel 2, CBS-TV</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/1246683</unitid><unitdate calendar="gregorian" datechar="creation" era="ce" normal="1973/1973">1973</unitdate><materialspec id="2fa4810149